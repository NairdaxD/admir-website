<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Înregistrare în Moldova IT Park — impozit unic 7%. Servicii turn-key pentru companii internaționale. AdMir Consulting.">
    <title>IT Park Gateway — AdMir Consulting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div id="navbar-placeholder"></div>
    
    <header class="section page-hero" style="background-image: url('/images/itpark_section.jpg');">
        <div class="container text-center">
            <h1 class="reveal" data-ro="IT Park Gateway" data-en="IT Park Gateway">IT Park Gateway</h1>
            <p class="section-desc reveal text-gold" data-ro="Cel mai avantajos regim fiscal pentru IT din Europa. 7% impozit unic." data-en="The most advantageous IT tax regime in Europe. 7% single tax.">Cel mai avantajos regim fiscal pentru IT din Europa. 7% impozit unic.</p>
        </div>
    </header>

    <section class="section section-alt">
        <div class="container">
            <div class="text-center reveal">
                <h2 class="section-header" data-ro="Beneficii Cheie" data-en="Key Benefits">Beneficii Cheie</h2>
            </div>
            <div class="itpark-benefits grid-3 reveal-stagger">
                <div class="benefit-item glass text-center">
                    <div class="benefit-number text-gold">7%</div>
                    <p data-ro="Impozit unic pe venit brut — înlocuiește impozit pe venit, TVA, contribuții sociale" data-en="Single tax on gross revenue — replaces income tax, VAT, social contributions">Impozit unic pe venit brut — înlocuiește impozit pe venit, TVA, contribuții sociale</p>
                </div>
                <div class="benefit-item glass text-center">
                    <div class="benefit-number text-gold">0%</div>
                    <p data-ro="Impozit pe dividende distribuite fondatorilor" data-en="Tax on dividends distributed to founders">Impozit pe dividende distribuite fondatorilor</p>
                </div>
                <div class="benefit-item glass text-center">
                    <div class="benefit-number text-gold">2-4</div>
                    <p data-ro="Săptămâni — de la zero la companie operațională" data-en="Weeks — from zero to operational company">Săptămâni — de la zero la companie operațională</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="text-center reveal">
                <h2 class="section-header" data-ro="Pachete de Servicii" data-en="Service Packages">Pachete de Servicii</h2>
            </div>
            <div class="grid-3 service-cards-grid reveal-stagger">
                <div class="service-card glass">
                    <div class="service-card-icon">⚡</div>
                    <h3 data-ro="IT Park Fast-Track" data-en="IT Park Fast-Track">IT Park Fast-Track</h3>
                    <ul class="benefit-item">
                        <li data-ro="Înregistrare SRL la ASP" data-en="LLC registration at ASP">Înregistrare SRL la ASP</li>
                        <li data-ro="Obținere rezidență IT Park" data-en="Obtaining IT Park residency">Obținere rezidență IT Park</li>
                        <li data-ro="Deschidere cont bancar" data-en="Bank account opening">Deschidere cont bancar</li>
                        <li data-ro="Set complet documente juridice" data-en="Complete set of legal documents">Set complet documente juridice</li>
                        <li data-ro="Configurare contabilitate" data-en="Accounting setup">Configurare contabilitate</li>
                    </ul>
                    <div class="service-card-price">
                        <span class="price-amount" data-ro="1.500 – 2.500 EUR" data-en="1,500 – 2,500 EUR">1.500 – 2.500 EUR</span>
                        <span class="price-note" data-ro="(one-time)" data-en="(one-time)">(one-time)</span>
                    </div>
                    <a href="contact.html" class="btn btn-outline btn-full" data-ro="Începe acum →" data-en="Start now →">Începe acum →</a>
                </div>

                <div class="service-card service-card-accent glass featured">
                    <div class="service-card-badge" data-ro="RECOMANDAT" data-en="RECOMMENDED">RECOMANDAT</div>
                    <div class="service-card-icon">🔄</div>
                    <h3 data-ro="IT Park Maintenance" data-en="IT Park Maintenance">IT Park Maintenance</h3>
                    <ul class="benefit-item">
                        <li data-ro="Contabilitate lunară" data-en="Monthly accounting">Contabilitate lunară</li>
                        <li data-ro="Raportare fiscală" data-en="Tax reporting">Raportare fiscală</li>
                        <li data-ro="Suport juridic curent" data-en="Ongoing legal support">Suport juridic curent</li>
                        <li data-ro="Conformitate IT Park" data-en="IT Park compliance">Conformitate IT Park</li>
                        <li data-ro="Administrare HR" data-en="HR administration">Administrare HR</li>
                    </ul>
                    <div class="service-card-price">
                        <span class="price-amount" data-ro="200 – 500 EUR" data-en="200 – 500 EUR">200 – 500 EUR</span>
                        <span class="price-note" data-ro="pe lună" data-en="per month">pe lună</span>
                    </div>
                    <a href="contact.html" class="btn btn-primary btn-full" data-ro="Solicită ofertă →" data-en="Request offer →">Solicită ofertă →</a>
                </div>

                <div class="service-card glass">
                    <div class="service-card-icon">🏢</div>
                    <h3 data-ro="IT Park Premium" data-en="IT Park Premium">IT Park Premium</h3>
                    <ul class="benefit-item">
                        <li data-ro="Enterprise Relocation" data-en="Enterprise Relocation">Enterprise Relocation</li>
                        <li data-ro="Restructurare corporativă internațională" data-en="International corporate restructuring">Restructurare corporativă internațională</li>
                        <li data-ro="Transfer pricing" data-en="Transfer pricing">Transfer pricing</li>
                        <li data-ro="IP structuring" data-en="IP structuring">IP structuring</li>
                        <li data-ro="Setup filială" data-en="Branch setup">Setup filială</li>
                    </ul>
                    <div class="service-card-price">
                        <span class="price-amount" data-ro="5.000 – 15.000 EUR" data-en="5,000 – 15,000 EUR">5.000 – 15.000 EUR</span>
                        <span class="price-note" data-ro="+ retainer lunar" data-en="+ monthly retainer">+ retainer lunar</span>
                    </div>
                    <a href="contact.html" class="btn btn-outline btn-full" data-ro="Programează un call →" data-en="Schedule a call →">Programează un call →</a>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-alt">
        <div class="container">
            <div class="text-center reveal">
                <h2 class="section-header" data-ro="Calculator Fiscal IT Park" data-en="IT Park Tax Calculator">Calculator Fiscal IT Park</h2>
            </div>
            
            <div class="calculator calculator-itpark glass active reveal">
                <div class="calc-grid grid-2">
                    <div class="calc-inputs">
                        <h3 class="text-gold" data-ro="Parametrii companiei" data-en="Company parameters">Parametrii companiei</h3>
                        
                        <div class="calc-field">
                            <label for="itpark-revenue" data-ro="Venit anual (EUR)" data-en="Annual revenue (EUR)">Venit anual (EUR)</label>
                            <input type="range" id="itpark-revenue" class="calc-range" min="10000" max="500000" step="5000" value="100000">
                            <div class="range-display"><span id="itpark-revenue-value">100.000</span> EUR</div>
                        </div>

                        <div class="calc-field">
                            <label for="itpark-employees" data-ro="Număr de angajați" data-en="Number of employees">Număr de angajați</label>
                            <input type="range" id="itpark-employees" class="calc-range" min="1" max="50" step="1" value="5">
                            <div class="range-display"><span id="itpark-employees-value">5</span></div>
                        </div>

                        <div class="calc-field">
                            <label for="itpark-salary" data-ro="Salariu mediu brut (EUR)" data-en="Average gross salary (EUR)">Salariu mediu brut (EUR)</label>
                            <input type="range" id="itpark-salary" class="calc-range" min="500" max="5000" step="100" value="1500">
                            <div class="range-display"><span id="itpark-salary-value">1.500</span> EUR</div>
                        </div>

                        <div class="calc-field">
                            <label for="itpark-country" data-ro="Țară pentru comparație" data-en="Country for comparison">Țară pentru comparație</label>
                            <select id="itpark-country" class="calc-select">
                                <option value="romania" data-ro="România (~45%)" data-en="Romania (~45%)">România (~45%)</option>
                                <option value="germany" data-ro="Germania (~50%)" data-en="Germany (~50%)">Germania (~50%)</option>
                                <option value="uk" data-ro="Marea Britanie (~40%)" data-en="UK (~40%)">Marea Britanie (~40%)</option>
                                <option value="usa" data-ro="SUA (~42%)" data-en="USA (~42%)">SUA (~42%)</option>
                                <option value="netherlands" data-ro="Olanda (~48%)" data-en="Netherlands (~48%)">Olanda (~48%)</option>
                                <option value="poland" data-ro="Polonia (~36%)" data-en="Poland (~36%)">Polonia (~36%)</option>
                                <option value="france" data-ro="Franța (~55%)" data-en="France (~55%)">Franța (~55%)</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="calc-results">
                        <h3 class="text-gold" data-ro="Comparație fiscală" data-en="Tax comparison">Comparație fiscală</h3>
                        
                        <div class="result-card glass result-highlight">
                            <div class="result-label" data-ro="Economie anuală" data-en="Annual savings">Economie anuală</div>
                            <span id="itpark-result-savings" class="result-value text-gold"></span>
                        </div>
                        
                        <div class="result-row grid-2">
                            <div class="result-mini glass result-good">
                                <div class="result-label" data-ro="Impozit IT Park" data-en="IT Park Tax">Impozit IT Park</div>
                                <span id="itpark-result-md" class="result-value-sm"></span>
                            </div>
                            <div class="result-mini glass result-bad">
                                <div class="result-label" data-ro="Impozit comparativ" data-en="Comparative Tax">Impozit comparativ</div>
                                <span id="itpark-result-other" class="result-value-sm"></span>
                            </div>
                        </div>

                        <div class="result-card glass">
                            <div class="result-label" data-ro="Economie pe 5 ani" data-en="5-year savings">Economie pe 5 ani</div>
                            <span id="itpark-result-5year" class="result-value-sm text-gold"></span>
                        </div>

                        <p id="itpark-warning" style="display:none;" data-ro="Avertisment" data-en="Warning"></p>
                        
                        <p class="calc-note" data-ro="Calcul simplificat. Contactați-ne pentru detalii." data-en="Simplified calculation. Contact us for details.">Calcul simplificat. Contactați-ne pentru detalii.</p>
                        
                        <a href="contact.html" class="btn btn-primary btn-full" data-ro="Analiză fiscală gratuită →" data-en="Free tax analysis →">Analiză fiscală gratuită →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="cta-band">
        <div class="container cta-band-content text-center reveal">
            <h2 data-ro="Înregistrează-ți compania în IT Park" data-en="Register your company in IT Park">Înregistrează-ți compania în IT Park</h2>
            <a href="contact.html" class="btn btn-primary btn-lg" data-ro="Contactează-ne" data-en="Contact us">Contactează-ne</a>
        </div>
    </div>

    <div id="footer-placeholder"></div>
    <script is:inline src="/js/components.js"></script>
    <script is:inline src="/js/main.js"></script>
</body>
</html>
