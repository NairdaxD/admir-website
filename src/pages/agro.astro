    <section class="section section-alt">
        <div class="container">
            <div class="text-center reveal">
                <h2 class="section-header" data-ro="Calculator Subvenții" data-en="Subsidies Calculator">Calculator Subvenții</h2>
            </div>
            
            <div class="calculator calculator-aipa glass active reveal">
                <div class="calc-grid grid-2">
                    <div class="calc-inputs">
                        <h3 class="text-gold" data-ro="Parametrii investiției" data-en="Investment parameters">Parametrii investiției</h3>
                        
                        <div class="calc-field">
                            <label for="aipa-type" data-ro="Tip investiție" data-en="Investment type">Tip investiție</label>
                            <select id="aipa-type" class="calc-select">
                                <option value="equipment" data-ro="Echipamente și utilaje agricole" data-en="Agricultural equipment and machinery">Echipamente și utilaje agricole</option>
                                <option value="irrigation" data-ro="Sisteme de irigare" data-en="Irrigation systems">Sisteme de irigare</option>
                                <option value="greenhouse" data-ro="Sere și solarii" data-en="Greenhouses">Sere și solarii</option>
                                <option value="livestock" data-ro="Zootehnie / fermă animale" data-en="Livestock / animal farm">Zootehnie / fermă animale</option>
                                <option value="processing" data-ro="Procesare produse agricole" data-en="Agricultural products processing">Procesare produse agricole</option>
                                <option value="orchard" data-ro="Livezi și plantații" data-en="Orchards and plantations">Livezi și plantații</option>
                            </select>
                        </div>
                        
                        <div class="calc-field">
                            <label for="aipa-amount" data-ro="Valoare investiție" data-en="Investment amount">Valoare investiție</label>
                            <input type="range" id="aipa-amount" class="calc-range" min="50000" max="10000000" step="50000" value="500000">
                            <div class="range-display"><span id="aipa-amount-value">500.000</span> MDL</div>
                            <div class="range-labels">
                                <span data-ro="50k" data-en="50k">50k</span>
                                <span data-ro="10M" data-en="10M">10M</span>
                            </div>
                        </div>

                        <div class="calc-field">
                            <label for="aipa-hectares" data-ro="Suprafață" data-en="Area">Suprafață</label>
                            <input type="range" id="aipa-hectares" class="calc-range" min="1" max="500" step="1" value="50">
                            <div class="range-display"><span id="aipa-hectares-value">50</span> ha</div>
                        </div>

                        <div class="calc-field">
                            <label for="aipa-entity" data-ro="Formă juridică" data-en="Legal entity">Formă juridică</label>
                            <select id="aipa-entity" class="calc-select">
                                <option value="individual" data-ro="Gospodărie Țărănească (GȚ)" data-en="Peasant Farm (GȚ)">Gospodărie Țărănească (GȚ)</option>
                                <option value="srl" data-ro="SRL" data-en="LLC (SRL)">SRL</option>
                                <option value="cooperative" data-ro="Cooperativă Agricolă (+5% bonus)" data-en="Agricultural Cooperative (+5% bonus)">Cooperativă Agricolă (+5% bonus)</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="calc-results">
                        <h3 class="text-gold" data-ro="Estimarea subvenției" data-en="Subsidy estimate">Estimarea subvenției</h3>
                        
                        <div class="result-card glass">
                            <div class="result-label" data-ro="Subvenție estimată" data-en="Estimated subsidy">Subvenție estimată</div>
                            <span id="aipa-result-subsidy" class="result-value text-gold">250.000 MDL</span>
                        </div>
                        
                        <div class="result-row grid-2">
                            <div class="result-mini glass">
                                <div class="result-label" data-ro="Rata subvenției" data-en="Subsidy rate">Rata subvenției</div>
                                <span id="aipa-result-rate" class="result-value-sm">50%</span>
                            </div>
                            <div class="result-mini glass">
                                <div class="result-label" data-ro="ROI estimat" data-en="Estimated ROI">ROI estimat</div>
                                <span id="aipa-result-roi" class="result-value-sm">100%</span>
                            </div>
                        </div>
                        
                        <p class="calc-note" data-ro="Aceasta este o estimare. Contactați-ne pentru o evaluare personalizată a dosarului dvs." data-en="This is an estimate. Contact us for a personalized evaluation of your file.">Aceasta este o estimare. Contactați-ne pentru o evaluare personalizată a dosarului dvs.</p>
                        
                        <a href="contact.html" class="btn btn-primary btn-full" data-ro="Evaluare gratuită →" data-en="Free evaluation →">Evaluare gratuită →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

