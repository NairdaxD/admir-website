<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Capabilități complete pentru fiecare etapă a afacerii tale.">
    <title>Servicii — AdMir Consulting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div id="navbar-placeholder"></div>
    <main>
        <section class="page-hero section reveal">
            <div class="container">
                <h1 data-ro="Servicii" data-en="Services">Servicii</h1>
                <p class="section-desc" data-ro="Capabilități complete pentru fiecare etapă a afacerii tale" data-en="Complete capabilities for every stage of your business">Capabilități complete pentru fiecare etapă a afacerii tale</p>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="capability-grid reveal-stagger">
                    <div class="capability-card">
                        <span class="capability-number">01</span>
                        <h3 data-ro="Strategie & Dezvoltare" data-en="Strategy & Development">Strategie & Dezvoltare</h3>
                        <p data-ro="Construim planuri de acțiune care transformă viziunea în rezultate measurabile." data-en="We build action plans that turn vision into measurable results.">Construim planuri de acțiune care transformă viziunea în rezultate measurabile.</p>
                        <ul class="capability-list">
                            <li data-ro="Planuri de afaceri" data-en="Business plans">Planuri de afaceri</li>
                            <li data-ro="Studii de fezabilitate" data-en="Feasibility studies">Studii de fezabilitate</li>
                            <li data-ro="Restructurare corporativă" data-en="Corporate restructuring">Restructurare corporativă</li>
                            <li data-ro="Market entry & expansiune" data-en="Market entry & expansion">Market entry & expansiune</li>
                            <li data-ro="Planificare strategică" data-en="Strategic planning">Planificare strategică</li>
                        </ul>
                    </div>

                    <div class="capability-card">
                        <span class="capability-number">02</span>
                        <h3 data-ro="Juridic & Conformitate" data-en="Legal & Compliance">Juridic & Conformitate</h3>
                        <p data-ro="Protejăm interesele afacerii tale cu soluții juridice solide și proactive." data-en="We protect your business interests with solid and proactive legal solutions.">Protejăm interesele afacerii tale cu soluții juridice solide și proactive.</p>
                        <ul class="capability-list">
                            <li data-ro="Contracte comerciale" data-en="Commercial contracts">Contracte comerciale</li>
                            <li data-ro="Dreptul muncii" data-en="Employment law">Dreptul muncii</li>
                            <li data-ro="Due Diligence" data-en="Due Diligence">Due Diligence</li>
                            <li data-ro="Proprietate intelectuală" data-en="Intellectual property">Proprietate intelectuală</li>
                            <li data-ro="Litigii & arbitraj" data-en="Litigation & arbitration">Litigii & arbitraj</li>
                            <li data-ro="Conformitate reglementară" data-en="Regulatory compliance">Conformitate reglementară</li>
                        </ul>
                    </div>

                    <div class="capability-card">
                        <span class="capability-number">03</span>
                        <h3 data-ro="Financiar & Fiscal" data-en="Financial & Tax">Financiar & Fiscal</h3>
                        <p data-ro="Optimizăm structura financiară pentru creștere sustenabilă și eficiență fiscală." data-en="We optimize the financial structure for sustainable growth and tax efficiency.">Optimizăm structura financiară pentru creștere sustenabilă și eficiență fiscală.</p>
                        <ul class="capability-list">
                            <li data-ro="Proiecții financiare" data-en="Financial projections">Proiecții financiare</li>
                            <li data-ro="Optimizare fiscală" data-en="Tax optimization">Optimizare fiscală</li>
                            <li data-ro="Atragere investiții" data-en="Investment attraction">Atragere investiții</li>
                            <li data-ro="Analize de fezabilitate" data-en="Feasibility analyses">Analize de fezabilitate</li>
                            <li data-ro="Transfer pricing" data-en="Transfer pricing">Transfer pricing</li>
                        </ul>
                    </div>

                    <div class="capability-card">
                        <span class="capability-number">04</span>
                        <h3 data-ro="Fonduri & Investiții" data-en="Funds & Investments">Fonduri & Investiții</h3>
                        <p data-ro="Transformăm oportunitățile de finanțare în proiecte aprobate și implementate." data-en="We turn funding opportunities into approved and implemented projects.">Transformăm oportunitățile de finanțare în proiecte aprobate și implementate.</p>
                        <ul class="capability-list">
                            <li data-ro="Subvenții agricole" data-en="Agricultural subsidies">Subvenții agricole</li>
                            <li data-ro="Fonduri UE de pre-aderare" data-en="EU pre-accession funds">Fonduri UE de pre-aderare</li>
                            <li data-ro="Granturi internaționale" data-en="International grants">Granturi internaționale</li>
                            <li data-ro="Scriere proiecte" data-en="Project writing">Scriere proiecte</li>
                            <li data-ro="Raportare & conformitate" data-en="Reporting & compliance">Raportare & conformitate</li>
                        </ul>
                    </div>

                    <div class="capability-card">
                        <span class="capability-number">05</span>
                        <h3 data-ro="Contabilitate" data-en="Accounting">Contabilitate</h3>
                        <p data-ro="Transparență totală și aliniere la reglementările naționale și internaționale." data-en="Total transparency and alignment with national and international regulations.">Transparență totală și aliniere la reglementările naționale și internaționale.</p>
                        <ul class="capability-list">
                            <li data-ro="Evidență contabilă" data-en="Accounting records">Evidență contabilă</li>
                            <li data-ro="Raportare financiară" data-en="Financial reporting">Raportare financiară</li>
                            <li data-ro="Declarații fiscale" data-en="Tax returns">Declarații fiscale</li>
                            <li data-ro="Salarizare (payroll)" data-en="Payroll">Salarizare (payroll)</li>
                            <li data-ro="Audit intern" data-en="Internal audit">Audit intern</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="section cta-band reveal">
            <div class="container text-center">
                <h2 data-ro="Ai nevoie de soluții personalizate?" data-en="Need personalized solutions?">Ai nevoie de soluții personalizate?</h2>
                <a href="contact.html" class="btn btn-primary" data-ro="Contactează-ne" data-en="Contact Us">Contactează-ne</a>
            </div>
        </section>
    </main>
    <div id="footer-placeholder"></div>
    <script is:inline src="/js/components.js"></script>
    <script is:inline src="/js/main.js"></script>
</body>
</html>
