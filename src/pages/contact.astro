<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Contactează AdMir Consulting.">
    <title>Contact — AdMir Consulting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .contact-info-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .contact-info-icon {
            font-size: 2rem;
            color: var(--gold-primary);
        }
        .contact-info-text h4 {
            margin-bottom: 0.25rem;
            color: var(--gold-light);
        }
        .contact-info-text p {
            color: #cbd5e1;
        }
        .contact-form {
            padding: 3rem;
            border-radius: 1rem;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #cbd5e1;
            font-weight: 500;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 1rem;
            border-radius: 0.5rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(15, 23, 42, 0.6);
            color: white;
            font-family: inherit;
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: var(--gold-primary);
            box-shadow: 0 0 0 2px rgba(201, 169, 105, 0.2);
        }
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div id="navbar-placeholder"></div>
    
    <section class="page-hero section">
        <div class="container text-center reveal">
            <h1 class="section-header"><span class="text-gold" data-ro="Contact" data-en="Contact">Contact</span></h1>
            <p class="section-desc" data-ro="Prima consultație este gratuită." data-en="The first consultation is free.">Prima consultație este gratuită.</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="grid-2 reveal">
                <div>
                    <h2 class="section-header" data-ro="Hai să discutăm" data-en="Let's Talk">Hai să discutăm</h2>
                    <p data-ro="Suntem aici pentru a răspunde la întrebările tale și a găsi cele mai bune soluții pentru afacerea ta." data-en="We are here to answer your questions and find the best solutions for your business." style="margin-bottom: 3rem; color: #cbd5e1;">Suntem aici pentru a răspunde la întrebările tale și a găsi cele mai bune soluții pentru afacerea ta.</p>
                    
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div class="contact-info-text">
                            <h4 data-ro="Adresă" data-en="Address">Adresă</h4>
                            <p data-ro="Chișinău, Republica Moldova" data-en="Chisinau, Republic of Moldova">Chișinău, Republica Moldova</p>
                        </div>
                    </div>
                    
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <div class="contact-info-text">
                            <h4 data-ro="Email" data-en="Email">Email</h4>
                            <p>contact@admirconsulting.md</p>
                        </div>
                    </div>
                    
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div class="contact-info-text">
                            <h4 data-ro="Telefon" data-en="Phone">Telefon</h4>
                            <p style="margin-bottom: 0.5rem;">+373 XX XXX XXX</p>
                            <a href="https://wa.me/373XXXXXXX" target="_blank" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.5rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                <span data-ro="Scrie-ne pe WhatsApp" data-en="Message us on WhatsApp">Scrie-ne pe WhatsApp</span>
                            </a>
                        </div>
                    </div>
                    
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="contact-info-text">
                            <h4 data-ro="Program" data-en="Hours">Program</h4>
                            <p data-ro="Luni – Vineri: 09:00 – 18:00" data-en="Monday – Friday: 09:00 – 18:00">Luni – Vineri: 09:00 – 18:00</p>
                        </div>
                    </div>
                </div>
                
                <div>
                    <form id="contact-form" class="contact-form glass">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="name" data-ro="Nume complet" data-en="Full Name">Nume complet *</label>
                                <input type="text" id="name" required placeholder="Ion Popescu">
                            </div>
                            <div class="form-group">
                                <label for="contact-info" data-ro="Email sau Telefon" data-en="Email or Phone">Email sau Telefon *</label>
                                <input type="text" id="contact-info" required placeholder="contact@email.com / +373...">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label for="service" data-ro="Serviciu de interes" data-en="Service of Interest">Serviciu de interes</label>
                            <select id="service" class="calc-select">
                                <option value="Subventii" data-ro="Subvenții" data-en="Subsidies">Subvenții</option>
                                <option value="Integrat" data-ro="Consulting Integrat" data-en="Integrated Consulting">Consulting Integrat</option>
                                <option value="Fonduri UE" data-ro="Fonduri UE" data-en="EU Funds">Fonduri UE</option>
                                <option value="IT Park Fast-Track" data-ro="IT Park Fast-Track" data-en="IT Park Fast-Track">IT Park Fast-Track</option>
                                <option value="IT Park Maintenance" data-ro="IT Park Maintenance" data-en="IT Park Maintenance">IT Park Maintenance</option>
                                <option value="IT Park Premium" data-ro="IT Park Premium" data-en="IT Park Premium">IT Park Premium</option>
                                <option value="Juridic" data-ro="Consultanță Juridică" data-en="Legal Consulting">Consultanță Juridică</option>
                                <option value="Financiar" data-ro="Consultanță Financiară" data-en="Financial Consulting">Consultanță Financiară</option>
                                <option value="Contabilitate" data-ro="Contabilitate" data-en="Accounting">Contabilitate</option>
                                <option value="Altele" data-ro="Altele" data-en="Other">Altele</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="message" data-ro="Mesaj" data-en="Message">Mesaj *</label>
                            <textarea id="message" rows="5" required data-ro="Cu ce te putem ajuta?" data-en="How can we help you?" placeholder="Cu ce te putem ajuta?"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary" style="width: 100%;" data-ro="Trimite Mesaj" data-en="Send Message">Trimite Mesaj</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <div id="footer-placeholder"></div>
    <script is:inline src="/js/components.js"></script>
    <script is:inline src="/js/main.js"></script>
</body>
</html>
